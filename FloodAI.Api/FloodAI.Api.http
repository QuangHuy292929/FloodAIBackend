@host = http://localhost:5289

GET {{host}}/health

###

GET {{host}}/openapi/v1.json
Accept: application/json

###

GET {{host}}/api/v1/basins
Accept: application/json

###

GET {{host}}/api/v1/basins/1/stations
Accept: application/json

###

# Replace 1 with the ID of a registered station.
GET {{host}}/api/v1/stations/1/metrics
Accept: application/json

###

GET {{host}}/api/v1/stations/1/observations?metric=water_level&from=2021-01-01&to=2021-01-02&pageSize=12
Accept: application/json

###

GET {{host}}/api/v1/stations/1/models
Accept: application/json

###

# Replace stationId with the registered Trung Trang station ID.
POST {{host}}/api/v1/forecasts/historical
Content-Type: application/json

{
  "stationId": 1,
  "issueTimeLocal": "2022-10-15T12:00:00"
}


###

POST https://localhost:7202/api/v1/auth/register
Content-Type: application/json

{
  "email": "demo@example.com",
  "password": "Demo-Change-Me-2026",
  "displayName": "FloodAI Demo"
}

###

POST https://localhost:7202/api/v1/auth/login
Content-Type: application/json

{
  "email": "demo@example.com",
  "password": "Demo-Change-Me-2026"
}

###

# Replace the placeholder with accessToken from login.
GET https://localhost:7202/api/v1/me
Authorization: Bearer REPLACE_WITH_ACCESS_TOKEN


###

GET {{host}}/api/v1/areas
Accept: application/json

###

# Replace the area ID with an active area ID.
GET {{host}}/api/v1/areas/1/posts?type=FLOOD_REPORT&page=1&pageSize=20
Accept: application/json

###

POST https://localhost:7202/api/v1/posts
Authorization: Bearer REPLACE_WITH_ACCESS_TOKEN
Content-Type: application/json

{
  "areaId": 1,
  "title": "Tình hình mưa",
  "content": "Cập nhật ghi nhận tại địa phương.",
  "postType": "WEATHER_UPDATE",
  "observedAt": "2022-10-15T12:00:00+07:00"
}
