{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ForecastInference": {
    "BaseUrl": "http://127.0.0.1:8091/"
  },
  "Weather": {
    "Cache": {
      "CurrentFreshFor": "00:15:00",
      "CurrentMaxAge": "01:00:00",
      "ForecastFreshFor": "01:00:00",
      "ForecastMaxAge": "06:00:00",
      "RetryAfterFailure": "00:01:00"
    }
  },
  "AllowedHosts": "*"
}
